<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference
        android:layout="@layout/pref_title"
        android:selectable="false" />
    <SwitchPreference
        android:defaultValue="false"
        android:icon="@drawable/apps_fill0_wght700_grad0_opsz48"
        android:key="switch_preference_autofill"
        android:title="@string/auto_fill_service" />

    <SwitchPreference
        android:defaultValue="true"
        android:icon="@drawable/filter_list_fill0_wght700_grad0_opsz48"
        android:key="switch_preference_compatible_mode_enabled"
        android:summary="@string/compatible_mode_describe_simply"
        android:title="@string/compatible_mode" />

    <ListPreference
        android:key="theme_preference"
        android:title="@string/theme"
        android:icon="@drawable/routine_fill0_wght700_grad200_opsz48__1_"
        android:persistent="false"
        android:entries="@array/theme_options"
        android:entryValues="@array/theme_values"
        android:defaultValue="system" />

    <SwitchPreference
        android:key="switch_preference_dynamic_color"
        android:icon="@drawable/palette_fill0_wght700_grad0_opsz48"
        android:persistent="false"
        android:summary="@string/dynamic_color_summary"
        android:title="@string/dynamic_color" />

    <Preference
        android:icon="@drawable/colorize_fill0_wght700_grad0_opsz48"
        android:key="preference_theme_color"
        android:persistent="false"
        android:summary="@string/theme_color_follow_wallpaper"
        android:title="@string/theme_color" />

    <ListPreference
        android:key="language_preference"
        android:title="@string/language"
        android:icon="@drawable/translate_fill0_wght700_grad0_opsz48"
        android:persistent="false"
        android:entries="@array/language_entries"
        android:entryValues="@array/language_values"
        android:defaultValue="system" />

    <SwitchPreference
        android:defaultValue="false"
        android:icon="@drawable/smartphone_fill0_wght700_grad200_opsz48"
        android:key="switch_preference_shoot_cut"
        android:summary="@string/prefer_screen_shot_summary"
        android:title="@string/allow_screen_recording" />

    <Preference
        android:icon="@drawable/star_fill0_wght700_grad0_opsz48"
        android:key="preference_quick_access"
        android:summary="@string/quick_access_summary"
        android:title="@string/quick_access" />

    <Preference
        android:icon="@drawable/security_fill0_wght700_grad0_opsz48__1_"
        android:key="preference_change_credential"
        android:persistent="false"
        android:summary="@string/set_unlock_credential"
        android:title="@string/change_unlock_credential" />

    <Preference
        android:icon="@drawable/security_fill0_wght700_grad0_opsz48__1_"
        android:key="preference_security_check"
        android:summary="@string/security_check_summary"
        android:title="@string/security_check" />

    <Preference
        android:icon="@drawable/delete_fill0_wght700_grad0_opsz48__1_"
        android:key="preference_recycle_bin"
        android:summary="@string/recycle_bin_summary"
        android:title="@string/recycle_bin" />

    <Preference
        android:icon="@drawable/database_fill0_wght700_grad0_opsz48"
        android:key="preference_backup_export"
        android:summary="@string/backup_export_summary"
        android:title="@string/backup_export_title" />

    <Preference
        android:icon="@drawable/folder_fill0_wght700_grad0_opsz48"
        android:key="preference_backup_import"
        android:summary="@string/backup_import_summary"
        android:title="@string/backup_import_title" />
    <PreferenceCategory
        android:key="preference_demo_data_category"
        android:title="@string/demo_data">

        <Preference
            android:icon="@drawable/apps_fill0_wght700_grad0_opsz48"
            android:key="preference_generate_demo_data"
            android:persistent="false"
            android:summary="@string/generate_demo_data_summary"
            android:title="@string/generate_demo_data" />

        <Preference
            android:icon="@drawable/delete_fill0_wght700_grad0_opsz48__1_"
            android:key="preference_clear_demo_data"
            android:persistent="false"
            android:summary="@string/clear_demo_data_summary"
            android:title="@string/clear_demo_data" />
    </PreferenceCategory>
</PreferenceScreen>

    <!--CheckBoxPreference：复选框，用于开启或关闭某个功能或选项。

    DropDownPreference：下拉框，用于从一个列表中选择一个选项。

    EditTextPreference：文本输入框，用于输入一段文本，比如用户名、密码等。

    ListPreference：列表选择框，用于从一个列表中选择一个选项。

    MultiSelectListPreference：多选列表选择框，用于从一个列表中选择多个选项。

    Preference：偏好设置项的基类，可以用于展示一些文本或图标等内容。

    PreferenceCategory：偏好设置分类，可以将一组相关的偏好设置项放在同一个分类下。

    PreferenceScreen：偏好设置屏幕，用于展示一组偏好设置项。

    SeekBarPreference：滑动条，用于选择一个数值，比如音量大小、亮度等。

    SwitchPreferenceCompat：开关按钮，用于开启或关闭某个功能或选项。-->
