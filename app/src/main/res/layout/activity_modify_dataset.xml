<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.newitem.NewItem">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            app:icon="@drawable/close_fill0_wght700_grad0_opsz48" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/save"
            android:layout_toEndOf="@id/cancel"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:text="@string/modify"
            android:textSize="20sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save"
            style="?attr/materialIconButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:icon="@drawable/done_fill0_wght700_grad0_opsz48" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linearLayout_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/shapeableImageView"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="40dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                app:srcCompat="@drawable/app_ic" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/materialTextView_appName_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/app_name"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:tag="username"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/account_circle_fill0_wght700_grad0_opsz48">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText_account"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/account" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:tag="phone"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/call_fill0_wght700_grad0_opsz48">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:tag="email"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/mail_fill0_wght700_grad0_opsz48">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/email" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:tag="password"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/key_fill0_wght700_grad0_opsz48">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/password" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:tag="card"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/credit_card_fill0_wght700_grad0_opsz48">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/bankcard" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:tag="cvv"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/security_fill0_wght700_grad0_opsz48__1_">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText_cvv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cvv" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:tag="issuing_bank"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/location_city_fill0_wght700_grad0_opsz48">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText_issuing_bank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/issuing_bank" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="15dp"
                android:tag="website"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/language_fill0_wght700_grad0_opsz48">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText_website"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/website" />

            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>